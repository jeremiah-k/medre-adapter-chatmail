{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "enabledManagers": [
    "pep621",
    "github-actions",
    "dockerfile",
    "docker-compose",
    "asdf",
    "custom.regex"
  ],
  "timezone": "America/Chicago",
  "dependencyDashboard": true,
  "automerge": false,
  "packageRules": [
    {
      "description": "Qualify the RPC client and native server as one version pair",
      "matchPackageNames": ["deltachat-rpc-client", "deltachat-rpc-server"],
      "groupName": "Chatmail RPC client and server"
    },
    {
      "description": "Keep Python support and deliberate CI minors under project review",
      "matchDepTypes": ["requires-python", "uses-with"],
      "matchPackageNames": ["python"],
      "enabled": false
    },
    {
      "description": "Preserve the supported core compatibility range",
      "matchPackageNames": ["medre"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Review coordinated tool upgrades after the shared quality gate",
      "matchFileNames": [".trunk/trunk.yaml"],
      "groupName": "Trunk toolchain",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "description": "Keep the license disclosure pinned requirement current with pyproject",
      "matchStrings": [
        "`(?<depName>[A-Za-z0-9_.-]+)(?:\\[[a-z,]+\\])?==(?<currentValue>[^`\\s]+)`"
      ],
      "datasourceTemplate": "pypi",
      "customType": "regex",
      "managerFilePatterns": ["/^DEPENDENCY_LICENSES\\.md$/"]
    },
    {
      "customType": "regex",
      "description": "Track Trunk CLI, plugins and linters from their declared upstream package sources",
      "managerFilePatterns": ["/^\\.trunk/trunk\\.yaml$/"],
      "matchStrings": [
        "(?:@|version:\\s+|ref:\\s+v?)(?<currentValue>[0-9][^\\s]*)\\s+# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ]
}
